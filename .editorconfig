# Editing standards for Microsoft Visual Studio and other code editors
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{html,css,js,mjs,json}]
indent_size = 2

[*.{md,txt}]
trim_trailing_whitespace = false
